# ─────────────────────────────────────────────────────────────
# 8BitField Frontend – Environment Variables
# Copy this file to .env.local for local development.
# Set these in the Vercel dashboard for production.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash, no /api suffix)
# Local:      http://localhost:5000
# Production: https://lumiora-backend.vercel.app
BACKEND_API_URL=http://localhost:5000

# Optional privacy-conscious analytics (Plausible)
# Leave unset to disable remote analytics; local event logging still works in development.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=8bitfield.com
